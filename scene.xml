<mujoco model="scene">
    <include file="so101_new_calib.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
        <texture type="cube" name="cubeTex" builtin="checker" mark="cross" rgb1="0.85 0.1 0.1"
            rgb2="0.95 0.85 0.1" markrgb="0.1 0.4 0.9" width="128" height="128" />
        <material name="cubeMat" texture="cubeTex" texuniform="true" specular="0.3" shininess="0.4" />
        <material name="targetMat" rgba="0.1 0.9 0.2 0.5" specular="0.1" shininess="0.1" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <body name="cube" pos="0.2 0 0.025">
            <freejoint name="cube" />
            <geom name="cubeGeom" type="box" size="0.02 0.02 0.02" material="cubeMat"
                density="500" friction="1 0.005 0.0001" />
        </body>

        <!-- Statischer Body ohne joint: fix im World-Frame, xpos bleibt über
             gesamte Episode/Training konstant. contype/conaffinity=0 -> keine
             Kollision mit cube oder Arm, rein visuell + für get_target_position(). -->
        <body name="target" pos="0.3 0.15 0.021">
            <geom name="targetGeom" type="cylinder" size="0.05 0.001" material="targetMat"
                contype="0" conaffinity="0" group="1" />
        </body>

        <!-- Unsichtbarer Referenzpunkt in der Mitte des vorderen Viertelkreises
             (1. Quadrant), auf den die Kamera ausgerichtet wird. Kein Geom mit
             Volumen -> keine Kollision, kein Rendering (size=0). -->
        <body name="workspaceCenter" pos="0.2 0.2 0.05">
            <geom name="workspaceCenterGeom" type="sphere" size="0.001" contype="0"
                conaffinity="0" group="3" rgba="0 0 0 0" />
        </body>

        <!-- Seitliche RGB-Kamera: Position auf der -x-Seite, Blick entlang +x
             auf den vorderen Viertelkreis (1. Quadrant), in dem Cube/Target
             liegen. mode="targetbody" richtet die Kamera automatisch auf
             workspaceCenter aus, unabhängig von Positionsänderungen des Cubes. -->
        <camera name="rgb_camera" pos="-0.4 0.2 0.35" mode="targetbody" target="workspaceCenter" />
    </worldbody>
</mujoco>